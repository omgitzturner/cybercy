# Copy this file to .env and fill in the values before starting the server.
# All variables listed here are required.

# PostgreSQL connection string
DATABASE_URL=postgresql://user:pass@localhost:5432/cybertraining

# JWT secrets — use long, random strings (min 32 characters each)
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
JWT_REFRESH_SECRET=your-super-secret-refresh-key-min-32-chars

PORT=5000
NODE_ENV=development
